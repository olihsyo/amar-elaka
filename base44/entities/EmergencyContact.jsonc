{
  "name": "EmergencyContact",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "category": {
      "type": "string",
      "enum": [
        "ambulance",
        "hospital",
        "police",
        "fire",
        "other"
      ]
    },
    "phone": {
      "type": "string"
    },
    "address": {
      "type": "string"
    },
    "locality_name": {
      "type": "string"
    },
    "verified": {
      "type": "boolean",
      "default": false
    },
    "last_verified": {
      "type": "string",
      "format": "date"
    },
    "source": {
      "type": "string"
    }
  },
  "required": [
    "name",
    "category",
    "phone"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}