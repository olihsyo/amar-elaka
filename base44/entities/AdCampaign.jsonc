{
  "name": "AdCampaign",
  "type": "object",
  "properties": {
    "business_name": {
      "type": "string"
    },
    "creative_url": {
      "type": "string"
    },
    "destination_url": {
      "type": "string"
    },
    "placement": {
      "type": "string",
      "enum": [
        "home",
        "news",
        "directory"
      ],
      "default": "home"
    },
    "start_date": {
      "type": "string",
      "format": "date"
    },
    "end_date": {
      "type": "string",
      "format": "date"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "approved",
        "rejected",
        "expired"
      ],
      "default": "pending"
    },
    "budget": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "business_name",
    "placement"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}