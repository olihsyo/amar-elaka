{
  "name": "Job",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "company": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "location": {
      "type": "string"
    },
    "type": {
      "type": "string",
      "enum": [
        "full_time",
        "part_time",
        "tutoring",
        "training",
        "business"
      ],
      "default": "full_time"
    },
    "salary": {
      "type": "string"
    },
    "contact": {
      "type": "string"
    },
    "expires_at": {
      "type": "string",
      "format": "date"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "closed",
        "pending"
      ],
      "default": "active"
    },
    "locality_name": {
      "type": "string"
    }
  },
  "required": [
    "title",
    "description"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.status": {
            "$ne": "pending"
          }
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}